<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNumCompteEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compte :"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSoldeCompteEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solde : 0 $"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/txtMontantEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Montant"
        android:inputType="numberDecimal"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCrediter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Créditer" />

        <Button
            android:id="@+id/btnDebiter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Débiter" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRetourEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retour" />
</LinearLayout>
